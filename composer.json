{
  "name": "on1kel/hyperf-fly-docs",
  "description": "Полуавтоматическая генерация OpenAPI 3.1 документации для Hyperf-приложений.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "hyperf",
    "openapi",
    "swagger",
    "documentation",
    "api-docs",
    "fly-docs"
  ],
  "require": {
    "php": "^8.2",
    "hyperf/http-server": "^3.1",
    "hyperf/command": "^3.1",
    "hyperf/config": "^3.1",
    "hyperf/http-message": "^3.1",
    "hyperf/support": "^3.1",
    "khazhinov/php-support": "^1.1",
    "on1kel/oas-profile-31": "^1.0",
    "on1kel/oas-builder": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "hyperf/framework": "^3.1",
    "friendsofphp/php-cs-fixer": "^3.0",
    "hyperf/testing": "^3.1",
    "phpstan/phpstan": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "On1kel\\HyperfFlyDocs\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "On1kel\\HyperfFlyDocs\\": "tests/"
    }
  },
  "extra": {
    "hyperf": {
      "config": "On1kel\\HyperfFlyDocs\\ConfigProvider"
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --configuration phpstan.neon --no-progress",
    "format": "vendor/bin/php-cs-fixer fix --config cs_dist.php --allow-risky=yes --show-progress=none"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
